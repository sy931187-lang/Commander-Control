end

local function GetRequestFunction()
    if type(request) == "function" then
        return request
    elseif type(http_request) == "function" then
        return http_request
    elseif type(syn) == "table" and type(syn.request) == "function" then
        return syn.request
    end
    return nil
end

local function HandleTalkMessage(Sender, RawText)
    if not TalkRunning or not TalkTarget or Sender ~= TalkTarget then return end
    if type(RawText) ~= "string" then return end

    -- Every !q message is sent to Commander AI.
    -- The Cloudflare Worker decides whether to use Google Search:
    -- messages ending in ? use research; other messages use normal chat.
    local Question = RawText:match("^%s*!q%s+(.+)$")
    if not Question then return end
    Question = Question:sub(1, 500)

    if os.clock() - TalkLastReplyAt < 3 then return end
    TalkLastReplyAt = os.clock()

    local MyToken = TalkToken
    task.spawn(function()
        local RequestFunction = GetRequestFunction()
        if not RequestFunction then
            warn("[TALK] Delta does not expose a supported HTTP request function.")
            return
        end

        local Payload = {
            target = Sender.DisplayName ~= "" and Sender.DisplayName or Sender.Name,
            message = Question,
            history = TalkHistory
        }

        local Ok, Response = pcall(function()
            return RequestFunction({
                Url = COMMANDER_AI_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["Authorization"] = "Bearer " .. COMMANDER_TOKEN
                },
                Body = HttpService:JSONEncode(Payload)
            })
        end)

        if MyToken ~= TalkToken or not TalkRunning then return end
        if not Ok or type(Response) ~= "table" then
            warn("[TALK] HTTP request failed: " .. tostring(Response))
            return
        end

        local StatusCode = tonumber(Response.StatusCode or Response.Status or 0)
        if StatusCode < 200 or StatusCode >= 300 then
            warn("[TALK] Worker returned HTTP " .. tostring(StatusCode) .. ". Check token/deployment.")
            return
        end

        local Body = Response.Body or Response.body
        if type(Body) ~= "string" then
            warn("[TALK] Worker returned an invalid response body.")
            return
        end

        local DecodedOk, Data = pcall(function()
            return HttpService:JSONDecode(Body)
        end)
        if not DecodedOk or type(Data) ~= "table" or type(Data.reply) ~= "string" then
            warn("[TALK] Could not read the AI reply from the Worker.")
            return
        end

        local Reply = Data.reply:gsub("%s+", " "):sub(1, 150)
        if Reply == "" then return end

        table.insert(TalkHistory, { role = "user", text = Question })
        table.insert(TalkHistory, { role = "model", text = Reply })
        while #TalkHistory > 8 do table.remove(TalkHistory, 1) end

        if MyToken == TalkToken and TalkRunning and not SendChat(Reply) then
            warn("[TALK] Roblox chat send failed.")
        end
    end)
end

