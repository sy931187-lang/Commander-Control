elseif Command == "!unspam" then

local Alt = Parts[2]

if MatchesLocalSelector(Alt) then
StopSpam()
end

elseif Command == "!prime" then

local Alt = Parts[2]
local TargetText = Parts[3]

if MatchesLocalSelector(Alt)
and TargetText then

StartPrime(TargetText)

end

elseif Command == "!unprime" then

local Alt = Parts[2]

if MatchesLocalSelector(Alt) then
StopPrime()
end

elseif Command == "!leave"
or Command == "!exit" then

local Alt = Parts[2]

if MatchesLocalSelector(Alt) then

pcall(function()
game:Shutdown()
end)

end

end
end

local ConnectedChannels = {}

local function ConnectChannel(Channel)

if not Channel:IsA("TextChannel") then
return
end

if ConnectedChannels[Channel] then
return
end

ConnectedChannels[Channel] = true

Channel.MessageReceived:Connect(
function(Message)

if not Message.TextSource then
return
end

local SenderUserId =
Message.TextSource.UserId

local CommandSender =
Players:GetPlayerByUserId(SenderUserId)

if not CommandSender then
return
end

-- Listen for !q from the selected talk target, independently of command permissions.
HandleTalkMessage(CommandSender, Message.Text)

local IsJack =
IsPrimaryOwner(CommandSender)

local IsCommander =
SelectedCommander
and SenderUserId == SelectedCommander.UserId

local IsOwner =
IsCurrentOwner(CommandSender)

if not IsJack and not IsCommander and not IsOwner then
return
end

ProcessCommand(
Message.Text,
CommandSender
)

end
)
end

local function ConnectAllChannels()

local Channels =
TextChatService:FindFirstChild(
"TextChannels"
)

if not Channels then
return
end

for _, Channel in ipairs(
Channels:GetChildren()
) do

ConnectChannel(Channel)

end
end

local ChannelsFolder =
TextChatService:FindFirstChild(
"TextChannels"
)

if ChannelsFolder then

ConnectAllChannels()

ChannelsFolder.ChildAdded:Connect(
function(Child)

task.wait(0.1)

ConnectChannel(Child)

end
)

else

TextChatService.ChildAdded:Connect(
function(Child)

if Child.Name == "TextChannels" then

task.wait(0.1)

ConnectAllChannels()

Child.ChildAdded:Connect(
function(Channel)

task.wait(0.1)

ConnectChannel(
Channel
)

end
)

end
end
)

end

