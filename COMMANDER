-- Brookhaven interaction-menu helpers used by !piggy.
local GuiService = game:GetService("GuiService")

local function ClickScreenPoint(Position)
    local Input = game:GetService("VirtualInputManager")
    local X, Y = math.floor(Position.X + 0.5), math.floor(Position.Y + 0.5)

    -- Commander Control's own ScreenGui (especially its floating JZ button)
    -- can sit above Brookhaven's interaction menu and steal the simulated click.
    -- Temporarily disable only our GUI during the click, then restore its state.
    local OwnGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    OwnGui = OwnGui and OwnGui:FindFirstChild("CommanderControl")
    local WasEnabled = OwnGui and OwnGui.Enabled
    if OwnGui then OwnGui.Enabled = false end

    local Success = pcall(function()
        Input:SendMouseMoveEvent(X, Y, game)
        task.wait(0.08)
        Input:SendMouseButtonEvent(X, Y, 0, true, game, 0)
        task.wait(0.08)
        Input:SendMouseButtonEvent(X, Y, 0, false, game, 0)
    end)

    if OwnGui then OwnGui.Enabled = WasEnabled end
    print(string.format("[PIGGY] Mouse click attempted at %d, %d (success=%s; Commander GUI restored=%s)", X, Y, tostring(Success), tostring(WasEnabled)))
    return Success
end

local function FindPiggybackButton()
    local PlayerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not PlayerGui then return nil end

    -- Use the exact Brookhaven hierarchy reported by the user's diagnostic first.
    local MainGui = PlayerGui:FindFirstChild("MainGUIHandler")
    local Client2Client = MainGui and MainGui:FindFirstChild("Client2Client")
    local WhiteCircle = Client2Client and Client2Client:FindFirstChild("WhiteCircle")
    local MainOpen = WhiteCircle and WhiteCircle:FindFirstChild("MainOpen")
    local WhiteCirclePic = MainOpen and MainOpen:FindFirstChild("WhiteCirclePic")
    local Piggyback = WhiteCirclePic and WhiteCirclePic:FindFirstChild("Piggyback")

    if Piggyback and Piggyback:IsA("GuiButton") then
        return Piggyback
    end

    -- Fallback: locate a text label and walk upward to its real GuiButton.
    for _, Object in ipairs(PlayerGui:GetDescendants()) do
        if Object:IsA("TextLabel") then
            local Text = (Object.Text or ""):lower():gsub("%s+", "")
            if Text == "piggyback" then
                local Parent = Object.Parent
                while Parent and Parent ~= PlayerGui and not Parent:IsA("GuiButton") do
                    Parent = Parent.Parent
                end
                if Parent and Parent:IsA("GuiButton") then
                    return Parent
                end
            end
        end
    end

    return nil
end

local function ClickPiggybackOption()
    local Button = FindPiggybackButton()
    if not Button then
        return false
    end

    -- Wait until Brookhaven has actually laid out and displayed the option.
    if not Button.Visible or Button.AbsoluteSize.X <= 0 or Button.AbsoluteSize.Y <= 0 then
        return false
    end

    local Center = Button.AbsolutePosition + (Button.AbsoluteSize / 2)

    -- AbsolutePosition is in the ScreenGui coordinate space. Add the top-left
    -- inset only when the containing ScreenGui does not ignore the GUI inset.
    local ScreenGui = Button:FindFirstAncestorOfClass("ScreenGui")
    if ScreenGui and not ScreenGui.IgnoreGuiInset then
        local TopLeftInset = GuiService:GetGuiInset()
        Center = Center + TopLeftInset
    end

    print(string.format(
        "[PIGGY] Button=%s Pos=(%.1f, %.1f) Size=(%.1f, %.1f) Click=(%.1f, %.1f)",
        Button:GetFullName(),
        Button.AbsolutePosition.X,
        Button.AbsolutePosition.Y,
        Button.AbsoluteSize.X,
        Button.AbsoluteSize.Y,
        Center.X,
        Center.Y
    ))

    -- Prefer a real input click at the freshly measured center. GuiButton:Activate()
    -- can succeed without generating the same pointer event Brookhaven listens for.
    return ClickScreenPoint(Center)
end

local function HasPiggybackJoint(Target)
    local MyCharacter = LocalPlayer.Character
    local TargetCharacter = Target and Target.Character
    if not (MyCharacter and TargetCharacter) then
        return false
    end

    local function ConnectsCharacters(Object, CharacterA, CharacterB)
        if not (Object:IsA("Weld") or Object:IsA("WeldConstraint") or Object:IsA("Motor6D")) then
            return false
        end

        local Part0, Part1 = Object.Part0, Object.Part1
        return (Part0 and Part0:IsDescendantOf(CharacterA) and Part1 and Part1:IsDescendantOf(CharacterB))
            or (Part1 and Part1:IsDescendantOf(CharacterA) and Part0 and Part0:IsDescendantOf(CharacterB))
    end

    for _, Object in ipairs(MyCharacter:GetDescendants()) do
        if ConnectsCharacters(Object, MyCharacter, TargetCharacter) then
            return true
        end
    end

    for _, Object in ipairs(TargetCharacter:GetDescendants()) do
        if ConnectsCharacters(Object, TargetCharacter, MyCharacter) then
            return true
        end
    end

    return false
end

local function IsPiggybackAttached(Target)
    -- Only confirm attachment when Brookhaven creates an actual connection
    -- between the two characters. Do not infer acceptance from proximity:
    -- the alt's approach position can put Jack above/nearby and cause a
    -- false positive, which sends the alt home before Jack accepts.
    if HasPiggybackJoint(Target) then
        return true
    end

    local MyCharacter = LocalPlayer.Character
    local TargetCharacter = Target and Target.Character
    if not (MyCharacter and TargetCharacter) then
        return false
    end

    -- Some carrying systems use constraints rather than Weld/Motor6D.
    local ConstraintClasses = {
        AlignPosition = true,
        AlignOrientation = true,
        BallSocketConstraint = true,
        HingeConstraint = true,
        RopeConstraint = true,
        RodConstraint = true,
        SpringConstraint = true,
        CylindricalConstraint = true,
        PrismaticConstraint = true,
        UniversalConstraint = true,
        WeldConstraint = true
    }

    local function ConnectsCharacters(Object)
        if not ConstraintClasses[Object.ClassName] then
            return false
        end

        -- Attachment-based constraints (BallSocket, AlignPosition, etc.) do not
        -- expose Part0/Part1. Read only properties supported by that class.
        if Object:IsA("Constraint") then
            local Ok, A0, A1 = pcall(function()
                return Object.Attachment0, Object.Attachment1
            end)
            if Ok and A0 and A1 then
                local A0InMine = A0:IsDescendantOf(MyCharacter)
                local A0InTarget = A0:IsDescendantOf(TargetCharacter)
                local A1InMine = A1:IsDescendantOf(MyCharacter)
                local A1InTarget = A1:IsDescendantOf(TargetCharacter)
                if (A0InMine and A1InTarget) or (A0InTarget and A1InMine) then
                    return true
                end
            end
        end

        -- Part-based joints such as WeldConstraint expose Part0/Part1.
        if Object:IsA("JointInstance") or Object:IsA("WeldConstraint") then
            local Ok, P0, P1 = pcall(function()
                return Object.Part0, Object.Part1
            end)
            if Ok and P0 and P1 then
                return (P0:IsDescendantOf(MyCharacter) and P1:IsDescendantOf(TargetCharacter))
                    or (P1:IsDescendantOf(MyCharacter) and P0:IsDescendantOf(TargetCharacter))
            end
        end

        return false
    end

    for _, Object in ipairs(MyCharacter:GetDescendants()) do
        if ConnectsCharacters(Object) then
            return true
        end
    end
    for _, Object in ipairs(TargetCharacter:GetDescendants()) do
        if ConnectsCharacters(Object) then
            return true
        end
    end

    return false
end

local function WaitForPiggybackAttached(Target, Timeout)
    local Deadline = os.clock() + (Timeout or 30)

    while os.clock() < Deadline do
        if not Target or not Target.Parent then
            return false
        end

        if IsPiggybackAttached(Target) then
            print("[PIGGY] Attachment confirmed by a character joint/constraint.")
            return true
        end

        task.wait(0.2)
    end

    return false
end

local function SendPiggybackRequest(Target)
    local Character = Target and Target.Character
    local Camera = workspace.CurrentCamera
    if not (Character and Camera) then return false end

    -- Aim at Jack's visible torso. WorldToScreenPoint returns screen coordinates
    -- suitable for VirtualInputManager mouse events (ViewportPoint omits the GUI inset).
    local HitParts = {
        Character:FindFirstChild("UpperTorso"),
        Character:FindFirstChild("Torso"),
        Character:FindFirstChild("LowerTorso"),
        Character:FindFirstChild("Head")
    }

    local ClickedCharacter = false
    for _, HitPart in ipairs(HitParts) do
        if HitPart and HitPart:IsA("BasePart") then
            local ScreenPosition, OnScreen = Camera:WorldToScreenPoint(HitPart.Position)
            if OnScreen and ScreenPosition.Z > 0 then
                local Point = Vector2.new(ScreenPosition.X, ScreenPosition.Y)
                if ClickScreenPoint(Point) then
                    ClickedCharacter = true
                    task.wait(0.25)
                    break
                end
            end
        end
    end

    if not ClickedCharacter then return false end

    -- Wait for the interaction menu, then click the freshly measured Piggyback entry.
    for _ = 1, 30 do
        task.wait(0.1)
        local Button = FindPiggybackButton()
        if Button and Button.Visible and Button.AbsoluteSize.X > 0 and Button.AbsoluteSize.Y > 0 then
            return ClickPiggybackOption()
        end
    end
    warn("[PIGGY] Piggyback GUI button was not found or never became visible.")
    return false
end

