local function ShuffleTable(Table)

local NewTable = {}

for i, Value in ipairs(Table) do
NewTable[i] = Value
end

for i = #NewTable, 2, -1 do

local J = math.random(1, i)

NewTable[i], NewTable[J] =
NewTable[J], NewTable[i]

end

return NewTable
end

